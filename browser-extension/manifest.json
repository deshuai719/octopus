{
  "manifest_version": 3,
  "name": "Octopus 登录助手",
  "version": "0.1.0",
  "description": "在本机浏览器中辅助恢复 Octopus 站点登录凭据。",
  "key": "",
  "permissions": ["activeTab", "scripting", "storage", "tabs", "cookies", "sidePanel", "alarms"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": {
    "service_worker": "worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "读取 Octopus 恢复会话"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
