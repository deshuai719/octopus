{
  "manifest_version": 3,
  "name": "Octopus 登录助手",
  "version": "0.3.0",
  "description": "从已登录中转站直接创建或更新 Octopus 站点账号。",
  "key": "",
  "permissions": ["activeTab", "scripting", "storage", "tabs", "cookies", "sidePanel", "alarms", "nativeMessaging", "downloads", "downloads.open"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": {
    "service_worker": "worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "识别当前站点并连接 Octopus"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
